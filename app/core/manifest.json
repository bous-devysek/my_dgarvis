{
  "manifest_version": 3,
  "name": "Dgarvis YouTube Controller",
  "version": "1.0",
  "description": "Фоновое управление YouTube для голосового ассистента",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*://*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dgarvis-yt@local.ext"
    }
  }
}